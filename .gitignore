# Environment variables — NEVER commit these
.env
.env.local
.env.*.local
.env.production

# Dependencies
node_modules/

# Build output
dist/
build/

# Logs
/logs/
*.log

# Runtime data
pids/
*.pid
*.seed

# Temp uploads — dataset-image import ZIPs, etc. Transient, auto-cleaned
# by the backend itself (processDatasetImages()'s finally block / the
# hourly orphaned-upload sweep), never meant to be source-controlled.
tmp/

# OS files
.DS_Store
Thumbs.db

# One-off root-level backfill/scratch scripts (run once locally with
# `node ...`/`ts-node ...` and thrown away) — not related to the app itself,
# so they shouldn't be pushed. Scripts worth keeping belong in src/scripts/
# instead (already tracked there — see backfill-client-ids.ts etc.).
/backfill-*.js
/scratch-*.js

# QA test runner scripts, one-off patch/scratch scripts, and Excel updaters
_investigate-stats.mjs
src/scripts/test_*
src/scripts/update_excel*
src/scripts/update_row*
src/scripts/inspect_*
src/scripts/patch_*
src/scripts/scan_*
src/scripts/check_*
src/scripts/backfill-ticket-numbers.ts
tests/*.test.ts


# Test fixtures and helpers: only the local Jest tests above use them
# (tests/*.test.ts is already ignored).
tests/fixtures/
tests/helpers/

# Developer check script (compares the CRM assistant's shared fixtures across
# the three repos; needs the ignored fixtures).
src/scripts/verify-crm-assist-contract-sync.ts

# One-off data scripts, run by hand against a database and then not needed
# (same as backfill-ticket-numbers.ts above).
src/scripts/backfill-invoice-work-order-locks.ts
src/scripts/check-duplicate-record-numbers.ts
src/scripts/cleanup-legacy-seeded-campaigns.ts
src/scripts/reconcile-invoice-paid-amounts.ts
