# Environment variables — NEVER commit these
.env
.env.local
.env.*.local
.env.production

# Dependencies
node_modules/

# Build output
dist/
build/

# Logs
/logs/
*.log

# Runtime data
pids/
*.pid
*.seed

# Temp uploads — dataset-image import ZIPs, etc. Transient, auto-cleaned
# by the backend itself (processDatasetImages()'s finally block / the
# hourly orphaned-upload sweep), never meant to be source-controlled.
tmp/

# OS files
.DS_Store
Thumbs.db

# One-off root-level backfill/scratch scripts (run once locally with
# `node ...`/`ts-node ...` and thrown away) — not related to the app itself,
# so they shouldn't be pushed. Scripts worth keeping belong in src/scripts/
# instead (already tracked there — see backfill-client-ids.ts etc.).
/backfill-*.js
/scratch-*.js
